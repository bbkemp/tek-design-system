.DS_Store
.vscode/settings.json
node_modules/
# dist/ is committed by CI so `git pull` gives you ready-to-use built files
package-lock.json
.claude/*
!.claude/skills/

# RAG POC: uploads/ is local-only — only processed outputs in
# screens/ etc. and index.md get committed.
rag/sources/*/uploads/*/*
!rag/sources/*/uploads/*/.gitkeep
# Safety net for PDFs misplaced at the product root (should live in uploads/pdfs/).
rag/sources/*/*.pdf
