.DS_Store
.vscode/settings.json
node_modules/
# dist/ is committed by CI so `git pull` gives you ready-to-use built files
package-lock.json
.claude/*
!.claude/skills/

# RAG POC: raw source photos are local-only — only the downscaled
# image + extracted markdown in screens/ get committed.
prototypes/rag-poc/sources/*/raw/*
!prototypes/rag-poc/sources/*/raw/.gitkeep
prototypes/rag-poc/sources/*/manual.pdf
