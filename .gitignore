.DS_Store
.vscode/settings.json
node_modules/
# dist/ is committed by CI so `git pull` gives you ready-to-use built files
.claude/*
!.claude/skills/
!.claude/settings.json

# Corpus: uploads/ is local-only — only processed outputs in
# screens/ etc. and index.md get committed.
corpus/sources/*/uploads/*/*
!corpus/sources/*/uploads/*/.gitkeep
# Safety net for PDFs misplaced at the subject root (should live in uploads/pdfs/).
corpus/sources/*/*.pdf

# Audits: competitive-analysis raw assets (vendor PDFs, source decks, screenshots)
# are local-only — only the synthesized report.md is committed.
audits/competitive/*/assets/*
!audits/competitive/*/assets/.gitkeep

# Corpus intake: drop zone for unsorted assets. Routed into corpus/sources/<subject>/uploads/<class>/
# (or audits/competitive/) by the /corpus-intake skill. README and .gitkeep are the only tracked
# files — everything else stays local until sorted.
corpus/_inbox/*
!corpus/_inbox/.gitkeep
!corpus/_inbox/README.md

# UXR (User Experience Research): provisional / discussion-stage material.
# Binaries (briefing PDFs, decks, spreadsheets) stay local; only markdown notes are committed.
uxr/**/*.pdf
uxr/**/*.pptx
uxr/**/*.ppt
uxr/**/*.key
uxr/**/*.docx
uxr/**/*.doc
uxr/**/*.xlsx
uxr/**/*.xls
uxr/**/*.csv
uxr/**/*.zip
