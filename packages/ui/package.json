{
  "name": "@bbkemp/ui",
  "version": "1.0.6",
  "description": "Web Components for the Tek design system",
  "type": "module",
  "main": "dist/tek-ui.cjs",
  "module": "dist/tek-ui.js",
  "exports": {
    ".": {
      "import": "./dist/tek-ui.js",
      "require": "./dist/tek-ui.cjs"
    }
  },
  "types": "dist/tek-ui.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx rollup -c rollup.config.js",
    "dev": "npx rollup -c rollup.config.js --watch"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "@bbkemp/tokens": "^1.0.0"
  },
  "devDependencies": {
    "rollup": "^4.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "typescript": "^5.0.0"
  }
}
