{
  "color": {

    "selector": {
      "background": {
        "default":   { "$value": "{color.neutral.grey-700}", "$type": "color" },
        "unchecked": { "$value": "{color.neutral.grey-500}", "$type": "color" },
        "checked":   { "$value": "{color.neutral.grey-100}", "$type": "color" }
      },
      "border": {
        "unchecked": { "$value": "{color.neutral.grey-400}", "$type": "color" },
        "checked":   { "$value": "{color.neutral.grey-300}", "$type": "color" },
        "error":     { "$value": "{color.ui.alert-red}",     "$type": "color" }
      },
      "label": {
        "unchecked": { "$value": "{color.neutral.grey-100}", "$type": "color" },
        "checked":   { "$value": "{color.core.white}",       "$type": "color" },
        "error":     { "$value": "{color.core.white}",       "$type": "color" }
      }
    },

    "input": {
      "background": {
        "default": { "$value": "{color.neutral.grey-700}", "$type": "color" }
      },
      "border": {
        "default":  { "$value": "{color.neutral.grey-400}", "$type": "color" },
        "focus":    { "$value": "{color.core.white}",        "$type": "color" },
        "filled":   { "$value": "{color.neutral.grey-200}", "$type": "color" },
        "disabled": { "$value": "{color.neutral.grey-500}", "$type": "color" },
        "error":    { "$value": "{color.ui.alert-red}",     "$type": "color" }
      },
      "text": {
        "default":  { "$value": "{color.neutral.grey-300}", "$type": "color" },
        "focus":    { "$value": "{color.core.white}",        "$type": "color" },
        "filled":   { "$value": "{color.neutral.grey-100}", "$type": "color" },
        "disabled": { "$value": "{color.neutral.grey-500}", "$type": "color" },
        "error":    { "$value": "{color.core.white}",        "$type": "color" }
      },
      "label": {
        "default": { "$value": "{color.neutral.grey-100}", "$type": "color" }
      },
      "character-count": {
        "default": { "$value": "{color.neutral.grey-100}", "$type": "color" },
        "focus":   { "$value": "{color.core.white}",        "$type": "color" },
        "filled":  { "$value": "{color.neutral.grey-200}", "$type": "color" },
        "error":   { "$value": "{color.ui.alert-red}",     "$type": "color" },
        "warning": { "$value": "{color.ui.alert-amber}",   "$type": "color" }
      }
    },

    "button": {
      "background": {
        "default":  { "$value": "{color.neutral.grey-800}", "$type": "color" },
        "hover":    { "$value": "{color.core.black}",        "$type": "color" },
        "inactive": { "$value": "{color.neutral.grey-900}", "$type": "color" }
      },
      "border": {
        "default":  { "$value": "{color.core.tek-blue}",    "$type": "color" },
        "hover":    { "$value": "{color.core.tek-blue}",    "$type": "color" },
        "inactive": { "$value": "{color.neutral.grey-500}", "$type": "color" }
      },
      "text": {
        "default":  { "$value": "{color.neutral.grey-100}", "$type": "color" },
        "hover":    { "$value": "{color.core.white}",        "$type": "color" },
        "inactive": { "$value": "{color.neutral.grey-500}", "$type": "color" }
      }
    },

    "modal": {
      "background": {
        "default": { "$value": "{color.neutral.grey-900}", "$type": "color" }
      },
      "border": {
        "default": { "$value": "{color.neutral.grey-400}", "$type": "color" }
      },
      "text": {
        "default": { "$value": "{color.core.white}", "$type": "color" }
      }
    },

    "footer": {
      "background": {
        "default": { "$value": "{color.neutral.grey-700}", "$type": "color" }
      },
      "text": {
        "default": { "$value": "{color.neutral.grey-100}", "$type": "color" }
      }
    },

    "text-link": {
      "default": { "$value": "{color.core.tek-blue}", "$type": "color" },
      "hover":   { "$value": "{color.core.tek-blue}", "$type": "color" }
    },

    "icons": {
      "default": { "$value": "{color.core.white}", "$type": "color" }
    }

  }
}
