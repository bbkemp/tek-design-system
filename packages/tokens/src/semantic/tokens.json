{
  "color": {

    "selector": {
      "background": {
        "default":   { "$value": "{colors.neutral.700}", "$type": "color" },
        "unchecked": { "$value": "{colors.neutral.500}", "$type": "color" },
        "checked":   { "$value": "{colors.neutral.100}", "$type": "color" }
      },
      "border": {
        "unchecked": { "$value": "{colors.neutral.400}",     "$type": "color" },
        "checked":   { "$value": "{colors.neutral.300}",     "$type": "color" },
        "error":     { "$value": "{colors.ui.error-red}",    "$type": "color" }
      },
      "label": {
        "unchecked": { "$value": "{colors.neutral.100}",     "$type": "color" },
        "checked":   { "$value": "{colors.neutral.white}",   "$type": "color" },
        "error":     { "$value": "{colors.neutral.white}",   "$type": "color" }
      }
    },

    "input": {
      "background": {
        "default": { "$value": "{colors.neutral.700}", "$type": "color" }
      },
      "border": {
        "default":  { "$value": "{colors.neutral.400}",   "$type": "color" },
        "focus":    { "$value": "{colors.neutral.white}",  "$type": "color" },
        "filled":   { "$value": "{colors.neutral.200}",   "$type": "color" },
        "disabled": { "$value": "{colors.neutral.500}",   "$type": "color" },
        "error":    { "$value": "{colors.ui.error-red}",  "$type": "color" }
      },
      "text": {
        "default":  { "$value": "{colors.neutral.300}",   "$type": "color" },
        "focus":    { "$value": "{colors.neutral.white}",  "$type": "color" },
        "filled":   { "$value": "{colors.neutral.100}",   "$type": "color" },
        "disabled": { "$value": "{colors.neutral.500}",   "$type": "color" },
        "error":    { "$value": "{colors.neutral.white}",  "$type": "color" }
      },
      "label": {
        "default": { "$value": "{colors.neutral.100}", "$type": "color" }
      },
      "character-count": {
        "default": { "$value": "{colors.neutral.100}",        "$type": "color" },
        "focus":   { "$value": "{colors.neutral.white}",       "$type": "color" },
        "filled":  { "$value": "{colors.neutral.200}",        "$type": "color" },
        "error":   { "$value": "{colors.ui.error-red}",       "$type": "color" },
        "warning": { "$value": "{colors.ui.warning-yellow}",  "$type": "color" }
      }
    },

    "button": {
      "background": {
        "default":  { "$value": "{colors.neutral.800}",  "$type": "color" },
        "hover":    { "$value": "{colors.neutral.black}", "$type": "color" },
        "inactive": { "$value": "{colors.neutral.900}",  "$type": "color" }
      },
      "border": {
        "default":  { "$value": "{colors.brand.tek-blue}", "$type": "color" },
        "hover":    { "$value": "{colors.brand.tek-blue}", "$type": "color" },
        "inactive": { "$value": "{colors.neutral.500}",    "$type": "color" }
      },
      "text": {
        "default":  { "$value": "{colors.neutral.100}",   "$type": "color" },
        "hover":    { "$value": "{colors.neutral.white}",  "$type": "color" },
        "inactive": { "$value": "{colors.neutral.500}",   "$type": "color" }
      }
    },

    "modal": {
      "background": {
        "default": { "$value": "{colors.neutral.900}", "$type": "color" }
      },
      "border": {
        "default": { "$value": "{colors.neutral.400}", "$type": "color" }
      },
      "text": {
        "default": { "$value": "{colors.neutral.white}", "$type": "color" }
      }
    },

    "footer": {
      "background": {
        "default": { "$value": "{colors.neutral.700}", "$type": "color" }
      },
      "text": {
        "default": { "$value": "{colors.neutral.100}", "$type": "color" }
      }
    },

    "text-link": {
      "default": { "$value": "{colors.brand.tek-blue}", "$type": "color" },
      "hover":   { "$value": "{colors.brand.tek-blue}", "$type": "color" }
    },

    "icons": {
      "default": { "$value": "{colors.neutral.white}", "$type": "color" }
    }

  }
}
