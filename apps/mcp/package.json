{
  "name": "tek-mcp-endpoint",
  "private": true,
  "version": "0.1.0",
  "description": "Tek MCP Endpoint — hosted MCP server over the design system and corpus (see docs/mcp-server-plan.md)",
  "scripts": {
    "dev": "next dev --port 3333",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "manifest": "cem analyze --config custom-elements-manifest.config.mjs",
    "ingest": "npm run manifest && tsx scripts/ingest.ts",
    "eval": "tsx eval/run.ts"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "@neondatabase/serverless": "^1.1.0",
    "gray-matter": "^4.0.3",
    "mcp-handler": "^1.1.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "customElements": "generated/custom-elements.json"
}
